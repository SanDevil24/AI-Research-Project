from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import (accuracy_score, recall_score, f1_score, roc_auc_score, precision_score, classification_report)

random_forest_model = RandomForestClassifier(n_estimators=100, class_weight = "balanced", random_state=42)
random_forest_model.fit(x_train, y_train)

random_forest_prediction = random_forest_model.predict(x_test)
random_forest_probability = random_forest_model.predict_proba(x_test)[:, 1]

print("Accuracy: ", accuracy_score(y_test, random_forest_prediction))
print("Precision: ", precision_score(y_test, random_forest_prediction))
print("Recall: ", recall_score(y_test, random_forest_prediction))
print("F1 Score: ", f1_score(y_test, random_forest_prediction))
print("AUROC Score: ", roc_auc_score(y_test, random_forest_probability))
print(classification_report(y_test, random_forest_prediction))


